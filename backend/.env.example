# SecureEval Backend Environment Variables
# Copy this file to .env and fill in your values

# --- Required ---

# Google Gemini API Key for AI-powered features (OCR, grading, reports)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK credentials
# Option 1: Path to service account JSON file (place in backend/ directory)
# Option 2: Full JSON string of the service account credentials
FIREBASE_CREDENTIALS=

# --- Optional ---

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Logging format: 'text' for human-readable, 'json' for structured/production
LOG_FORMAT=text

# CORS allowed origins (comma-separated). Use '*' for development only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
