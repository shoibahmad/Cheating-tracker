# SecureEval Frontend Environment Variables
# Copy this file to .env and fill in your values

# --- Required ---

# Firebase Web API Key (from Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# --- Optional ---

# Backend API URL (defaults to http://localhost:8000 in development)
# Leave empty in production to use relative paths (same-origin)
VITE_API_URL=
